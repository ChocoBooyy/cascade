#version 430

// advances one burst system a single tick, mirroring the cpu sim exactly: modifiers touch velocity,
// then position integrates, then the billboard roll advances by its spin. dispatched once per client
// tick, not per frame, so the motion stays frame rate independent like the cpu path

layout(local_size_x = 64) in;

struct Particle {
    vec4 pos;   // xyz position in emitter space, w billboard roll
    vec4 vel;   // xyz velocity per tick, w roll change per tick
};

layout(std430, binding = 0) buffer Particles {
    Particle particles[];
};

// force slots mirror the cpu modifier classes: 1 gravity (a.xyz accel), 2 drag (a.x velocity kept),
// 3 attractor (a.xyz center, b.x strength), 4 vortex (a.xyz center, b.x strength)
uniform int ForceCount;
uniform int ForceType[8];
uniform vec4 ForceA[8];
uniform vec4 ForceB[8];
uniform uint Count;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= Count) {
        return;
    }
    vec3 pos = particles[i].pos.xyz;
    vec3 vel = particles[i].vel.xyz;
    for (int f = 0; f < ForceCount; f++) {
        if (ForceType[f] == 1) {
            vel += ForceA[f].xyz;
        } else if (ForceType[f] == 2) {
            vel *= ForceA[f].x;
        } else if (ForceType[f] == 3) {
            vec3 d = ForceA[f].xyz - pos;
            float dist = length(d);
            if (dist >= 1e-4) {
                vel += d * (ForceB[f].x / dist);
            }
        } else if (ForceType[f] == 4) {
            vec2 r = pos.xz - ForceA[f].xz;
            float len = length(r);
            if (len >= 1e-4) {
                vel += vec3(-r.y, 0.0, r.x) * (ForceB[f].x / len);
            }
        }
    }
    pos += vel;
    particles[i].pos = vec4(pos, particles[i].pos.w + particles[i].vel.w);
    particles[i].vel = vec4(vel, particles[i].vel.w);
}
